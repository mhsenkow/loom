# Backend CORS allowlist (comma-separated)
LOOM_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOOM_LOG_LEVEL=INFO

# Logging noise controls
# Set to true to show uvicorn per-request access logs
LOOM_ACCESS_LOG=false
# Set httpx/httpcore logger level (WARNING keeps internal HTTP chatter quiet)
LOOM_HTTP_CLIENT_LOG_LEVEL=WARNING
# Socket.IO/Engine.IO internal event logs (ai_chunk emit spam, etc.)
LOOM_SOCKETIO_LOG=false
LOOM_ENGINEIO_LOG=false
# If true, keeps per-token "ai_chunk" emission lines in logs (very noisy)
LOOM_SOCKETIO_CHUNK_LOG=false
# Comma-separated endpoints to downgrade successful requests to DEBUG
LOOM_QUIET_REQUEST_PATHS=/health,/api/images/models,/api/code-context/status,/api/sessions

# Optional API key for /api/web/* endpoints (sent as X-LOOM-API-KEY)
# LOOM_WEB_API_KEY=change-me

# Web automation endpoint rate limit (requests per minute per IP/path)
LOOM_WEB_RATE_LIMIT_PER_MIN=60

# Internal backend-to-backend API base (used for screenshot vision analysis)
LOOM_INTERNAL_API_BASE_URL=http://localhost:8000

# Housekeeping for generated files (images/music)
LOOM_RUN_CLEANUP_ON_STARTUP=true
LOOM_GENERATED_MEDIA_RETENTION_DAYS=14

# Frontend API base URL
VITE_API_BASE_URL=http://localhost:8000
